{
  "name": "supabase-notes-quickstart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A complete local Supabase Auth and PostgreSQL private notes tutorial.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "supabase start && supabase migration up --local && node scripts/setup-env.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "stop": "supabase stop",
    "clean:database": "supabase stop --no-backup",
    "test:api": "node --test tests/api.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:api && npm run test:browser"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "supabase": "2.118.0",
    "vite": "8.3.1",
    "@playwright/test": "1.61.1"
  },
  "license": "MIT"
}
